# --- STRIPE ---
# Clé secrète Stripe en mode test (commence par sk_test_)
STRIPE_SECRET_KEY=sk_test_VOTRE_CLE_ICI

# Secret du webhook Stripe (obtenu dans le dashboard Stripe > Webhooks)
# En mode test local avec Stripe CLI : stripe listen --forward-to localhost:5000/webhook
STRIPE_WEBHOOK_SECRET=whsec_VOTRE_SECRET_WEBHOOK_ICI

# --- COMPTE PLATEFORME 126 ---
ENTITY_126_NAME=Société 126
ENTITY_126_SIREN=123456789
ENTITY_126_PERCENT=10

# --- EXPERT 1 ---
EXPERT1_NAME=Expert Alpha Conseil
EXPERT1_SIREN=111222333
EXPERT1_PERCENT=30
# ID du compte Stripe Connect Express de l'expert 1 (commence par acct_)
EXPERT1_STRIPE_ACCOUNT_ID=acct_VOTRE_ID_EXPERT1

# --- EXPERT 2 ---
EXPERT2_NAME=Beta Consulting SASU
EXPERT2_SIREN=444555666
EXPERT2_PERCENT=30
EXPERT2_STRIPE_ACCOUNT_ID=acct_VOTRE_ID_EXPERT2

# --- EXPERT 3 ---
EXPERT3_NAME=Gamma Expertise EI
EXPERT3_SIREN=777888999
EXPERT3_PERCENT=30
EXPERT3_STRIPE_ACCOUNT_ID=acct_VOTRE_ID_EXPERT3

