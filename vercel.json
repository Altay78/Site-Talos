{
  "trailingSlash": false,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/espace-client.html",
      "destination": "https://app.talos-ai.tech",
      "permanent": false
    },
    {
      "source": "/espace-client",
      "destination": "https://app.talos-ai.tech",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*).(css|js|svg|png|jpg|jpeg|webp|woff2)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    }
  ]
}
